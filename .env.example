# Copy to .env (never commit .env).
# Keep the dataset OUTSIDE OneDrive-synced folders: it is ~24 GB compressed.
SENTINEL_DATA_DIR=C:/Users/<you>/sentinel-data
SENTINEL_LOG_LEVEL=INFO
# Optional: HuggingFace token for faster/authenticated downloads (dataset is public).
# HF_TOKEN=
# Stage 3 (docker compose). Generate your own, e.g.: openssl rand -hex 24
SENTINEL_PG_ADMIN_PASSWORD=change-me
SENTINEL_API_DB_PASSWORD=change-me-too
SENTINEL_SHADOW_DB_PASSWORD=change-me-three
SENTINEL_GATE_DB_PASSWORD=change-me-four
SENTINEL_ROLLOUT_DB_PASSWORD=change-me-five
# Stage 8: alert worker (lag, alerts, retention) and the read-only Streamlit dashboard.
SENTINEL_MONITOR_DB_PASSWORD=change-me-six
SENTINEL_DASHBOARD_DB_PASSWORD=change-me-seven
# Stage 6 kill switch key (header X-API-Key on POST /admin/rollback). Empty = disabled.
SENTINEL_ADMIN_API_KEY=change-me-admin-key
# Host port for the scoring API (container listens on 8000).
# SENTINEL_API_PORT=18080
