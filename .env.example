# Copy to .env (never commit .env).
# Keep the dataset OUTSIDE OneDrive-synced folders: it is ~24 GB compressed.
SENTINEL_DATA_DIR=C:/Users/<you>/sentinel-data
SENTINEL_LOG_LEVEL=INFO
# Optional: HuggingFace token for faster/authenticated downloads (dataset is public).
# HF_TOKEN=
# Stage 3 (docker compose). Generate your own, e.g.: openssl rand -hex 24
SENTINEL_PG_ADMIN_PASSWORD=change-me
SENTINEL_API_DB_PASSWORD=change-me-too
# Host port for the scoring API (container listens on 8000).
# SENTINEL_API_PORT=18080
